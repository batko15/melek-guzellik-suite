// MELEK'ÇE GÜZELLİK — Güzellik & Tırnak Stüdyosu — Veri Modeli V3
// White-Label şablon: Hizmetler, Müşteriler, Randevular, Yorumlar, Galeri
// V2: Misafir randevusu (telefon ile, giriş gerekmez) + herkese açık değerlendirme
// V3: Rezervasyon Merkezi — tam randevu düzenleme, durum 'gelmedi' (no-show),
//     iç personel notu, güncelleme zamanı + Bildirim Günlüğü (müşteri bilgilendirme)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Hizmetler (Tırnak, Güzellik, Kirpik) ───────────────────────────────────
model Service {
  id          String    @id @default(cuid())
  name        String    // örn. «Jel Uzatma»
  category    String    // tirnak | guzellik | kirpik
  description String?   // açılış sayfası için kısa açıklama
  durationMin Int       // uygulama süresi (dakika)
  priceChf    Float     // fiyat (CHF)
  popular     Boolean   @default(false) // «Popüler» rozeti
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  bookings Booking[]
  reviews  Review[]
}

// ─── Müşteriler (girişsiz randevu: telefon ile otomatik oluşturulur) ─────────
model SalonCustomer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique // misafir randevularının anahtarı
  email     String?
  notes     String?   // iç notlar (alerjiler, tercihler)
  createdAt DateTime  @default(now())

  bookings Booking[]
}

// ─── Randevular ─────────────────────────────────────────────────────────────
model Booking {
  id          String        @id @default(cuid())
  customerId  String
  customer    SalonCustomer @relation(fields: [customerId], references: [id])
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  startAt     DateTime      // randevu başlangıcı
  durationMin Int           // hizmetten kopyalanır (anlık görüntü)
  priceChf    Float         // hizmetten kopyalanır (anlık görüntü)
  status      String        @default("bekliyor") // bekliyor | onaylandi | tamamlandi | iptal | gelmedi
  notes       String?       // müşteri isteği (örn. «Fransız + altın parıltı»)
  staffNote   String?       // iç not (yalnızca ekip görür — müşteriye bildirilmez)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  notifications NotificationLog[]

  @@index([startAt])
  @@index([customerId])
  @@index([status])
}

// ─── Değerlendirmeler (herkese açık, moderasyonlu) ──────────────────────────
model Review {
  id          String   @id @default(cuid())
  authorName  String   // değerlendirmeyi yazan kişinin adı
  rating      Int      // 1–5 yıldız
  comment     String   // yorum metni
  serviceId   String?  // isteğe bağlı: hangi hizmetle ilgili
  service     Service? @relation(fields: [serviceId], references: [id])
  status      String   @default("bekliyor") // bekliyor | onaylandi | reddedildi
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─── Bildirim Günlüğü (ekip → müşteri bilgilendirmeleri) ───────────────────
model NotificationLog {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer  String   // müşteri adı (bilgi amaçlı kopya)
  phone     String   // hedef telefon (WhatsApp/SMS)
  channel   String   // whatsapp | sms | email
  kind      String   // onay | degisiklik | iptal | hatirlatma | tamamlandi | ozel
  message   String   // gönderilen mesaj metni
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([bookingId])
}

// ─── Galeri (açılış sayfası için çalışmalar) ────────────────────────────────
model GalleryItem {
  id        String   @id @default(cuid())
  title     String   // örn. «Altın Barok»
  category  String   // tirnak | guzellik | kirpik | studyo
  imagePath String   // /gallery/nails-gold.png
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
